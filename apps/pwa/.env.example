# Environment Configuration for the PWA

# Backend API Configuration
# Relative path — works behind the nginx reverse proxy in devcontainer/Codespaces.
# For local development without nginx, set to http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=/api/v1


# Development Configuration
NODE_ENV=development

# Production Configuration (uncomment and set for production)
# NEXT_PUBLIC_API_URL=https://app.ir/api/v1
# NODE_ENV=production

# Microsoft Clarity Analytics Configuration
# Project ID from https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=clarity_project_id

# ─── Localization ──────────────────────────────────────────────────────────
# The language is negotiated automatically per visitor (browser language, then
# a client-side timezone check). There is no language switcher by design.

# Global override — pin EVERY visitor to one language regardless of their
# browser, cookie or URL. Leave empty for normal negotiation. Accepts: fa | en
LOCALE_OVERRIDE=
